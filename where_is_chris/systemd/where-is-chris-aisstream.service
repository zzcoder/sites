[Unit]
Description=Stream live AIS positions for Where is Chris
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/zhihongz/work/sites/where_is_chris
EnvironmentFile=-/home/zhihongz/work/sites/where_is_chris/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/zhihongz/venv/3.12/bin/python -m backend.aisstream
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
