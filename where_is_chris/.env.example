# MarineTraffic Single Vessel Positions API credential (40 hex characters).
MARINETRAFFIC_API_KEY=
MARINETRAFFIC_SHIP_ID=447122

# Free real-time WebSocket feed. MarineTraffic remains an optional fallback.
AISSTREAM_API_KEY=
AISSTREAM_MMSI=367482180
AISSTREAM_SHIP_NAME="BLUE SKY MESSENGER"

# Shared Neon Postgres pooled connection string. SQLite remains a local backup.
DATABASE_URL=
# Optional local-only alternative that reads DATABASE_URL from an existing private env file.
NEON_SHARED_ENV_FILE=

# Alert after four missed five-minute updates. Recovery alerts are also sent.
STALE_AFTER_MINUTES=20
OPENCLAW_BIN=/home/zhihongz/.openclaw/bin/openclaw
OPENCLAW_SLACK_TARGET=channel:C01QX86KMCN

# Use either a direct key or a Google API Keys resource ID.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY_ID=
GOOGLE_CLOUD_PROJECT=gmp-demo-project-332266878
GCLOUD_BIN=/home/zhihongz/.openclaw/bin/gcloud

WHERE_IS_CHRIS_DB=/home/zhihongz/work/sites/where_is_chris/data/positions.db
WHERE_IS_CHRIS_PUBLIC_PATH=/where-is-chris
