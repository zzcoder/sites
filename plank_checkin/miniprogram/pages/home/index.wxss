.screen {
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
  isolation: isolate;
}

.background-image,
.background-wash {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
}

.background-image {
  z-index: 0;
}

.background-wash {
  z-index: 1;
  background: linear-gradient(
    180deg,
    rgba(3, 28, 55, 0.98) 0%,
    rgba(9, 43, 77, 0.9) 22%,
    rgba(9, 43, 77, 0.22) 48%,
    rgba(8, 28, 51, 0.3) 100%
  );
}

.center-shell {
  box-sizing: border-box;
  position: relative;
  z-index: 2;
  min-height: 100vh;
  padding:
    calc(env(safe-area-inset-top) + 80rpx)
    44rpx
    calc(env(safe-area-inset-bottom) + 80rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  text-align: center;
}

.splash-mark {
  width: 132rpx;
  height: 132rpx;
  margin-bottom: 28rpx;
  border-radius: 32rpx;
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.22);
  overflow: hidden;
}

.splash-mark image,
.profile-logo {
  width: 100%;
  height: 100%;
}

.splash-title {
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 750;
  letter-spacing: -1rpx;
}

.splash-subtitle {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 27rpx;
}

.loader {
  width: 144rpx;
  height: 6rpx;
  margin-top: 56rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  overflow: hidden;
}

.loader view {
  width: 48%;
  height: 100%;
  border-radius: inherit;
  background: #ffad1f;
  animation: loading 1.25s ease-in-out infinite alternate;
}

@keyframes loading {
  from {
    transform: translateX(-70%);
  }
  to {
    transform: translateX(180%);
  }
}

.loading-copy {
  margin-top: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
}

.profile-shell {
  justify-content: flex-end;
}

.profile-card,
.error-card {
  box-sizing: border-box;
  width: 100%;
  padding: 50rpx 40rpx 42rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 40rpx;
  color: #08284c;
  text-align: left;
  background: rgba(255, 255, 255, 0.93);
  box-shadow: 0 28rpx 80rpx rgba(0, 16, 38, 0.28);
  backdrop-filter: blur(24rpx);
}

.profile-logo {
  display: block;
  width: 92rpx;
  height: 92rpx;
  margin-bottom: 32rpx;
  border-radius: 24rpx;
}

.profile-title,
.error-title {
  font-size: 38rpx;
  line-height: 1.22;
  font-weight: 760;
  letter-spacing: -0.7rpx;
}

.profile-zh,
.error-title-zh {
  margin-top: 7rpx;
  color: #59738e;
  font-size: 27rpx;
  font-weight: 550;
}

.profile-copy {
  margin-top: 28rpx;
  color: #3f5871;
  font-size: 25rpx;
  line-height: 1.58;
}

.profile-copy-zh {
  margin-top: 6rpx;
  color: #6e8398;
}

.field-label {
  margin: 28rpx 0 12rpx;
  color: #294965;
  font-size: 24rpx;
  font-weight: 650;
}

.text-input,
.reason-input {
  box-sizing: border-box;
  width: 100%;
  border: 2rpx solid #a9bfd4;
  border-radius: 22rpx;
  color: #08284c;
  background: rgba(255, 255, 255, 0.86);
}

.text-input {
  height: 94rpx;
  padding: 0 26rpx;
}

.reason-input {
  height: 180rpx;
  padding: 22rpx 26rpx;
}

.primary-button {
  box-sizing: border-box;
  width: 100%;
  min-height: 94rpx;
  margin: 30rpx 0 0;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.36);
  border-radius: 23rpx;
  color: #06284c;
  font-size: 29rpx;
  font-weight: 750;
  line-height: 1.15;
  background: linear-gradient(135deg, #ffd68d 0%, #ffb235 55%, #ff9f0f 100%);
  box-shadow: 0 14rpx 30rpx rgba(233, 138, 7, 0.2);
}

.primary-button[disabled] {
  color: #8294a5;
  background: #dce3e9;
  box-shadow: none;
}

.privacy-note {
  margin-top: 18rpx;
  color: #718599;
  font-size: 22rpx;
  text-align: center;
}

.error-card {
  text-align: center;
}

.error-icon {
  width: 78rpx;
  height: 78rpx;
  margin-bottom: 22rpx;
}

.error-copy {
  margin-top: 24rpx;
  color: #5b6f82;
  font-size: 25rpx;
  line-height: 1.5;
}

.app-page {
  box-sizing: border-box;
  position: relative;
  z-index: 2;
  min-height: 100vh;
  padding-bottom: calc(env(safe-area-inset-bottom) + 188rpx);
}

.topbar {
  box-sizing: border-box;
  min-height: 156rpx;
  padding:
    calc(env(safe-area-inset-top) + 20rpx)
    28rpx
    20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.16);
}

.brand-title {
  color: #ffffff;
  font-size: 31rpx;
  line-height: 1.2;
  font-weight: 760;
  letter-spacing: -0.5rpx;
}

.brand-zh {
  margin-top: 5rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 23rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 50%;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
  background: linear-gradient(145deg, #1b659d, #09294f);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.18);
}

.greeting-row {
  padding: 10rpx 30rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 15rpx;
  color: #ffffff;
}

.greeting-icon {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
}

.greeting {
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 520;
  letter-spacing: -0.7rpx;
}

.page-content {
  padding: 0 24rpx 50rpx;
}

.glass-dark,
.light-panel {
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 30rpx;
  backdrop-filter: blur(22rpx);
}

.glass-dark {
  border: 1rpx solid rgba(255, 255, 255, 0.19);
  color: #ffffff;
  background: rgba(4, 48, 87, 0.88);
  box-shadow: 0 18rpx 38rpx rgba(0, 17, 40, 0.18);
}

.light-panel {
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 40rpx rgba(0, 19, 43, 0.14);
}

.money-strip {
  min-height: 170rpx;
  display: flex;
  align-items: stretch;
}

.money-cell {
  box-sizing: border-box;
  width: 50%;
  padding: 28rpx 26rpx 24rpx;
}

.metric-label {
  min-height: 56rpx;
  color: #d2e1ef;
  font-size: 22rpx;
  line-height: 1.3;
}

.metric-value {
  margin-top: 3rpx;
  font-size: 47rpx;
  line-height: 1;
  font-weight: 780;
  letter-spacing: -1.6rpx;
}

.metric-value.accent,
.accent {
  color: #ffab18;
}

.money-divider,
.stats-divider {
  width: 1rpx;
  flex: 0 0 1rpx;
  background: rgba(255, 255, 255, 0.28);
}

.money-divider {
  margin: 28rpx 0;
}

.champion-card {
  min-height: 210rpx;
  margin-top: 20rpx;
  padding: 24rpx 0;
  display: flex;
  align-items: stretch;
}

.champion-cell {
  box-sizing: border-box;
  width: 46%;
  padding: 0 16rpx;
  text-align: center;
}

.section-icon {
  width: 39rpx;
  height: 39rpx;
}

.champion-label {
  margin-top: 6rpx;
  color: #d9e6f1;
  font-size: 21rpx;
  line-height: 1.25;
}

.champion-name {
  margin-top: 8rpx;
  font-size: 31rpx;
  font-weight: 740;
}

.champion-seconds {
  margin-top: 4rpx;
  color: #c0d2e1;
  font-size: 21rpx;
}

.stats-divider {
  margin: 4rpx 0;
}

.small-stat {
  box-sizing: border-box;
  width: 27%;
  padding: 42rpx 10rpx 0;
  color: #dbe6f0;
  font-size: 20rpx;
  line-height: 1.25;
  text-align: center;
}

.small-stat text {
  display: block;
  margin-top: 14rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 750;
}

.checkin-card {
  margin-top: 20rpx;
  padding: 35rpx 30rpx 30rpx;
}

.card-heading-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.card-title {
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 780;
  letter-spacing: -0.7rpx;
}

.card-subtitle {
  margin-top: 7rpx;
  color: #71889e;
  font-size: 24rpx;
}

.timer-icon {
  width: 44rpx;
  height: 44rpx;
}

.seconds-field {
  height: 178rpx;
  margin-top: 25rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid #8eb8df;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.68);
}

.seconds-field input {
  box-sizing: border-box;
  width: auto;
  min-width: 0;
  flex: 1;
  height: 150rpx;
  padding: 0;
  border: 0;
  color: #06284f;
  font-size: 98rpx;
  font-weight: 780;
  line-height: 150rpx;
  text-align: center;
  background: transparent;
}

.seconds-placeholder {
  color: #d5dce4;
}

.seconds-unit {
  flex: 0 0 auto;
  color: #526e89;
  font-size: 24rpx;
}

.checkin-button {
  margin-top: 22rpx;
}

.action-row,
.motto-row {
  box-sizing: border-box;
  width: 100%;
  min-height: 112rpx;
  margin: 18rpx 0 0;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  border-radius: 28rpx;
  color: #08284c;
  line-height: 1;
  text-align: left;
}

.action-row::after {
  border: 0;
}

.motto-row {
  min-height: 122rpx;
}

.action-icon-wrap {
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 10rpx 24rpx rgba(1, 36, 74, 0.1);
}

.action-icon-wrap image {
  width: 39rpx;
  height: 39rpx;
}

.action-copy {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}

.action-copy view {
  font-size: 27rpx;
  line-height: 1.22;
  font-weight: 730;
}

.action-copy text {
  display: block;
  margin-top: 8rpx;
  color: #71869a;
  font-size: 22rpx;
  line-height: 1.2;
}

.row-arrow {
  width: 30rpx;
  height: 30rpx;
  margin-left: 14rpx;
}

.screen-heading {
  padding: 6rpx 5rpx 22rpx;
  color: #ffffff;
}

.screen-title {
  font-size: 39rpx;
  line-height: 1.18;
  font-weight: 780;
  letter-spacing: -1rpx;
}

.screen-subtitle {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.65);
  font-size: 23rpx;
}

.ranking-panel {
  padding: 8rpx 24rpx;
}

.ranking-row {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #dce5ec;
}

.ranking-row:last-child {
  border-bottom: 0;
}

.rank-number {
  width: 50rpx;
  color: #7890a4;
  font-size: 26rpx;
  font-weight: 720;
  text-align: center;
}

.rank-1 .rank-number {
  color: #e38c00;
  font-size: 34rpx;
}

.rank-2 .rank-number {
  color: #6c7f92;
  font-size: 31rpx;
}

.rank-3 .rank-number {
  color: #a56e44;
  font-size: 29rpx;
}

.member-avatar {
  width: 60rpx;
  height: 60rpx;
  margin-left: 12rpx;
  flex: 0 0 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 720;
  background: linear-gradient(145deg, #3a7aae, #0b3963);
}

.member-avatar.small {
  width: 52rpx;
  height: 52rpx;
  margin-left: 0;
  flex-basis: 52rpx;
  font-size: 20rpx;
}

.ranking-name {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
  font-size: 28rpx;
  font-weight: 720;
}

.ranking-score {
  margin-left: 14rpx;
  color: #8798a8;
  font-size: 22rpx;
}

.ranking-score.checked {
  color: #0b5ca8;
  font-size: 29rpx;
  font-weight: 770;
}

.report-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.report-stat {
  min-height: 148rpx;
  padding: 27rpx 28rpx;
}

.report-stat text {
  color: #70869a;
  font-size: 21rpx;
}

.report-stat view {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 780;
}

.accent-stat {
  background: rgba(255, 240, 207, 0.96);
}

.accent-stat view {
  color: #e98d00;
}

.trend-panel,
.history-panel,
.admin-section {
  margin-top: 18rpx;
  padding: 28rpx 26rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 760;
}

.light-text {
  color: #ffffff;
}

.trend-chart {
  height: 196rpx;
  margin-top: 25rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 7rpx;
}

.trend-column {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.trend-count {
  margin-bottom: 6rpx;
  color: #d8e5ef;
  font-size: 17rpx;
}

.trend-bar {
  width: 72%;
  min-height: 18rpx;
  border-radius: 8rpx 8rpx 3rpx 3rpx;
  background: linear-gradient(180deg, #ffbf48, #f39300);
}

.trend-date {
  margin-top: 8rpx;
  color: #b8cbdc;
  font-size: 16rpx;
  white-space: nowrap;
}

.history-panel {
  padding-bottom: 18rpx;
}

.history-row {
  min-height: 63rpx;
  display: flex;
  align-items: center;
  gap: 13rpx;
}

.history-date {
  width: 60rpx;
  flex: 0 0 60rpx;
  color: #71879b;
  font-size: 20rpx;
}

.history-track {
  height: 15rpx;
  flex: 1;
  border-radius: 99rpx;
  background: #e1e8ed;
  overflow: hidden;
}

.history-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #1468aa, #61a8df);
}

.history-value {
  width: 66rpx;
  flex: 0 0 66rpx;
  font-size: 21rpx;
  font-weight: 720;
  text-align: right;
}

.admin-section:first-of-type {
  margin-top: 0;
}

.leave-request {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #dde6ed;
}

.leave-request:last-child {
  border-bottom: 0;
}

.request-topline {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.request-name {
  font-size: 27rpx;
  font-weight: 740;
}

.request-date {
  color: #71869a;
  font-size: 20rpx;
}

.request-reason {
  margin-top: 10rpx;
  color: #4f677e;
  font-size: 23rpx;
  line-height: 1.4;
}

.request-actions {
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
}

.secondary-button {
  min-height: 72rpx;
  margin: 0;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #b3c4d3;
  border-radius: 18rpx;
  color: #254967;
  font-size: 23rpx;
  font-weight: 690;
  line-height: 1.1;
  background: #ffffff;
}

.request-actions .secondary-button {
  flex: 1;
}

.secondary-button.approve {
  border-color: #318363;
  color: #ffffff;
  background: #318363;
}

.secondary-button.decline {
  border-color: #d49a94;
  color: #a33931;
  background: #fff9f8;
}

.admin-input {
  margin-top: 20rpx;
}

.switch-row {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.switch-title {
  font-size: 25rpx;
  font-weight: 690;
}

.switch-help {
  margin-top: 4rpx;
  color: #7d90a2;
  font-size: 20rpx;
}

.compact-button {
  min-height: 82rpx;
  margin-top: 24rpx;
  font-size: 26rpx;
}

.admin-user {
  min-height: 112rpx;
  padding: 20rpx 0;
  display: flex;
  align-items: flex-start;
  border-bottom: 1rpx solid #dde6ed;
}

.admin-user:last-child {
  border-bottom: 0;
}

.admin-user-copy {
  min-width: 0;
  flex: 1;
  margin-left: 15rpx;
}

.admin-user-name {
  font-size: 25rpx;
  font-weight: 730;
}

.admin-user-meta {
  margin-top: 4rpx;
  color: #7a8d9f;
  font-size: 19rpx;
}

.admin-user-side {
  margin-left: 12rpx;
  text-align: right;
}

.due-value {
  color: #e18b08;
  font-size: 25rpx;
  font-weight: 760;
}

.text-button {
  min-height: 36rpx;
  margin: 5rpx 0 0 auto;
  padding: 0;
  color: #0b5ca8;
  font-size: 19rpx;
  line-height: 36rpx;
  background: transparent;
}

.text-button.danger {
  color: #b0463d;
}

.inline-empty,
.empty-note {
  padding: 32rpx 8rpx 16rpx;
  color: #7b8e9f;
  font-size: 23rpx;
  text-align: center;
}

.empty-note {
  color: rgba(255, 255, 255, 0.68);
}

.bottom-nav {
  box-sizing: border-box;
  position: fixed;
  z-index: 20;
  right: 18rpx;
  bottom: 14rpx;
  left: 18rpx;
  min-height: 126rpx;
  padding: 11rpx 8rpx 8rpx;
  display: flex;
  align-items: flex-start;
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 35rpx;
  background: rgba(252, 253, 255, 0.92);
  box-shadow: 0 18rpx 50rpx rgba(0, 18, 42, 0.25);
  backdrop-filter: blur(26rpx);
}

.nav-item {
  min-width: 0;
  flex: 1;
  margin: 0;
  padding: 0 3rpx;
  color: #698097;
  line-height: 1;
  background: transparent;
}

.nav-icon-wrap {
  width: 57rpx;
  height: 57rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.nav-icon-wrap image {
  width: 34rpx;
  height: 34rpx;
  opacity: 0.68;
}

.nav-label {
  margin-top: 6rpx;
  overflow: hidden;
  font-size: 18rpx;
  font-weight: 620;
  line-height: 1.12;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-item.active {
  color: #075aa5;
}

.nav-item.active .nav-icon-wrap {
  background: #082f59;
  box-shadow: 0 8rpx 18rpx rgba(5, 47, 89, 0.25);
}

.nav-item.active .nav-icon-wrap image {
  filter: brightness(0) invert(1);
  opacity: 1;
}

.modal-backdrop {
  position: fixed;
  z-index: 50;
  inset: 0;
  padding: 40rpx 24rpx calc(env(safe-area-inset-bottom) + 20rpx);
  display: flex;
  align-items: flex-end;
  background: rgba(1, 15, 30, 0.56);
}

.modal-card {
  box-sizing: border-box;
  width: 100%;
  padding: 18rpx 30rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 28rpx 80rpx rgba(0, 0, 0, 0.28);
}

.modal-handle {
  width: 82rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: #c9d3dc;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 780;
}

.modal-copy {
  margin-top: 8rpx;
  color: #718599;
  font-size: 22rpx;
}

.modal-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 14rpx;
}

.modal-actions .secondary-button,
.modal-actions .primary-button {
  flex: 1;
  min-height: 82rpx;
  margin: 0;
}

.modal-submit {
  width: auto;
}

.cancel {
  color: #5e7488;
}
